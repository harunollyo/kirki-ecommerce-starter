<?xml version="1.0"?>
<ruleset name="Kirki Ecommerce Starter Coding Standards">
    <description>PHP_CodeSniffer ruleset for Kirki Ecommerce Starter theme.</description>

    <!-- Exclude paths -->
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/assets/css/*</exclude-pattern>
    <exclude-pattern>/\.git/*</exclude-pattern>

    <!-- Show progression and sniff codes -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Check all PHP files in directory -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- Use WordPress Coding Standards -->
    <rule ref="WordPress"/>

    <!-- Verify text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="kirki-ecommerce-starter"/>
        </properties>
    </rule>

    <!-- Check for PHP compatibility -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="7.4-"/>
</ruleset>
